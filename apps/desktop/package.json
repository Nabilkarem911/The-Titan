{
  "name": "@titan/desktop",
  "version": "0.1.0",
  "description": "Titan Desktop Agent — bridge between Titan Server and your local machine",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder",
