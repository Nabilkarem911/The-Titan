{
  "name": "@titan/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint config'",
    "test": "echo 'no tests yet'",
    "migrate": "node ./dist/migrate.js"
  },
  "dependencies": {
    "@titan/config": "0.1.0",
    "@titan/logging": "0.1.0",
    "@titan/shared": "0.1.0",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "typescript": "5.6.3"
  }
}
