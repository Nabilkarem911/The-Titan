# ============================================================================
# TITAN FOUNDATION - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in real values.
# All secrets must come from environment variables. Never hardcode.

# ------------------------- Core Application ---------------------------------
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=titan-core
SERVICE_VERSION=0.1.0

# ------------------------- HTTP Server --------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
HTTP_BODY_LIMIT=10485760
HTTP_REQUEST_TIMEOUT=30000

# ------------------------- Authentication -----------------------------------
# JWT (REQUIRED in production). Generate with: openssl rand -hex 64
JWT_SECRET=dev-only-secret-change-me-in-production-this-must-be-at-least-64-chars
JWT_ACCESS_TTL=900                # 15 minutes
JWT_REFRESH_TTL=604800            # 7 days
JWT_ISSUER=titan
JWT_AUDIENCE=titan-api

# API Key encryption key (REQUIRED in production). 32 bytes hex.
API_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------- PostgreSQL ---------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=titan
POSTGRES_USER=titan
POSTGRES_PASSWORD=titan_dev_password_change_in_production
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20
POSTGRES_STATEMENT_TIMEOUT=30000
POSTGRES_LOG_QUERIES=false

# ------------------------- Redis --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=titan:
REDIS_TLS=false
REDIS_CLUSTER=false

# ------------------------- Queue --------------------------------------------
QUEUE_DEFAULT_PRIORITY=5
QUEUE_REMOVE_ON_COMPLETE=1000
QUEUE_REMOVE_ON_FAIL=5000
QUEUE_ATTEMPTS_DEFAULT=3
QUEUE_BACKOFF_MS=2000

# ------------------------- WebSocket ----------------------------------------
WS_PATH=/ws
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=10000
WS_MAX_PAYLOAD=10485760
WS_MAX_CONNECTIONS_PER_USER=10

# ------------------------- Rate Limiting ------------------------------------
RATE_LIMIT_GLOBAL_PER_MIN=1000
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=100

# ------------------------- Telemetry (OpenTelemetry) -----------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=titan-core
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_LOG_LEVEL=error

# ------------------------- CORS ---------------------------------------------
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# ------------------------- Vault (Secrets Manager) -------------------------
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/titan
